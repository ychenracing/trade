#!/usr/bin/env python3
"""Normalize and compile-check the generated current formal documentation contract."""

from __future__ import annotations

from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
TEST_PATH = ROOT / "tests/contract/test_current_formal_documentation.py"


def main() -> int:
    text = TEST_PATH.read_text(encoding="utf-8")
    first_nonblank = next((line for line in text.splitlines() if line.strip()), "")
    if first_nonblank.startswith("            "):
        text = "\n".join(
            line[12:] if line.startswith("            ") else line
            for line in text.splitlines()
        ) + "\n"
    text = text.replace(
        '    combined_current = "\n".join((readme, validation, architecture))',
        '    combined_current = "\\n".join((readme, validation, architecture))',
    )
    compile(text, str(TEST_PATH), "exec")
    TEST_PATH.write_text(text, encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
