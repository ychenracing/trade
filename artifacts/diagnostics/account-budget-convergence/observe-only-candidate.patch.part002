+def budget_observation(
+    receipt: Mapping[str, Any], date: str, buy_count: int, reduction_count: int,
+) -> dict[str, Any]:
+    """Label hypothetical budget effects, never executable quantities or actions."""
+    observation = dict(receipt)
+    scales = list(observation.pop("buy_scales"))
+    scale = require_finite("budget buy scale", observation.pop("buy_scale"),
+                           min_value=0., max_value=1.)
+    if len(scales) != buy_count:
+        raise RuntimeError("account budget observation lost buy alignment")
+    for value in scales:
+        require_finite("budget buy scale", value, min_value=0., max_value=1.)
+    observation.update(
+        date=date, event="account_budget_observation", mechanism="AB5",
+        policy_mode="OBSERVE_ONLY", health_status="EVALUATED", status="OBSERVED",
+        trade_intervention_allowed=False,
+        observed_counterfactual_buy_scale=scale,
+        observed_counterfactual_buy_scales=scales,
+        observed_counterfactual_reduction_count=reduction_count,
