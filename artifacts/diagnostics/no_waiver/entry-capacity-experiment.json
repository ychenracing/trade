  "decision_rule": "No endpoint-neighbor coefficient sweep. Reject if joint wealth/protection/adjacency/risk fails; inspect first divergent economic decision to decide whether a structural target redesign has a separate causal basis. Full958 only for surviving candidate.",
  "source_patch": "diff --git a/quantfusion/config/engine.py b/quantfusion/config/engine.py\nindex 3abb2c4..c6c5576 100644\n--- a/quantfusion/config/engine.py\n+++ b/quantfusion/config/engine.py\n@@ -69,6 +69,7 @@ def default_engine_config() -> dict[str, Any]:\n         \"hard_stop\": 0.15,\n         \"strategy_weight\": 0.98,\n         \"max_symbol_weight\": 0.6,\n+        \"account_alert_max_symbol_weight\": 0.6,\n         \"max_total_weight\": 1.0,\n         \"max_units\": 20,\n         \"max_drawdown\": 0.165,\n@@ -336,7 +337,7 @@ def _validate_numeric_config(out: dict) -> None:\n         \"risk_pct\",\n         \"hard_stop\",\n         \"strategy_weight\",\n-        \"max_symbol_weight\",\n+        \"account_alert_max_symbol_weight\",\n         \"max_drawdown\",\n         \"daily_loss_limit\",\n         \"profit_lock_activation\",\n@@ -347,6 +348,10 @@ def _validate_numeric_config(out: dict) -> None:\n         out[key] = _require_positive(\n             key, out.get(key), max_value=1.0, inclusive_max=False\n         )\n+    out[\"max_symbol_weight\"] = _require_positive(\n+        \"max_symbol_weight\", out.get(\"max_symbol_weight\"),\n+        max_value=1.0, inclusive_max=True,\n+    )\n     out[\"max_total_weight\"] = _require_positive(\n         \"max_total_weight\",\n         out.get(\"max_total_weight\"),\ndiff --git a/quantfusion/risk/account_budget.py b/quantfusion/risk/account_budget.py\nindex d259022..e793726 100644\n--- a/quantfusion/risk/account_budget.py\n+++ b/quantfusion/risk/account_budget.py\n@@ -254,7 +254,8 @@ def plan_account_risk_budget(\n         if dominant_symbol is not None and equity else 0.\n     )\n     symbol_limit = require_finite(\n-        'max_symbol_weight', cfg['max_symbol_weight'], min_value=0., max_value=1.,\n+        'account_alert_max_symbol_weight', cfg['account_alert_max_symbol_weight'],\n+        min_value=0., max_value=1.,\n     )\n     daily_loss_limit = require_finite(\n         'daily_loss_limit', cfg['daily_loss_limit'], min_value=0.000001,\ndiff --git a/tests/unit/test_entry_capacity_separation.py b/tests/unit/test_entry_capacity_separation.py\nnew file mode 100644\nindex 0000000..af1f22e\n--- /dev/null\n+++ b/tests/unit/test_entry_capacity_separation.py\n@@ -0,0 +1,43 @@\n+\"\"\"Entry concentration may change without disabling account alert reductions.\"\"\"\n+\n+import pytest\n+\n+from quantfusion.config.engine import default_engine_config, validate_engine_config\n+from quantfusion.risk.account_budget import plan_account_risk_budget\n+from quantfusion.risk.managers import RiskManager\n+\n+\n+def test_full_cash_entry_endpoint_is_valid_but_leverage_is_not():\n+    cfg = default_engine_config()\n+    cfg['max_symbol_weight'] = 1.0\n+    assert validate_engine_config(cfg)['max_symbol_weight'] == 1.0\n+    cfg['max_symbol_weight'] = 1.001\n+    with pytest.raises(ValueError):\n+        validate_engine_config(cfg)\n+\n+\n+def test_entry_capacity_does_not_change_existing_book_alert_reductions():\n+    cfg = default_engine_config()\n+    books = [(0, '300308', 'turtle_breakout', 8000, 10.0)]\n+    kwargs = dict(date_str='2026-01-05', preserve_strategy_valid_holdings=True,\n+                  risk_alert_active=True)\n+    receipt, actions = plan_account_risk_budget(\n+        90000., 100000., cfg, books, [], lambda _: 1., **kwargs)\n+    assert actions\n+    cfg['max_symbol_weight'] = 1.0\n+    expanded_receipt, expanded_actions = plan_account_risk_budget(\n+        90000., 100000., cfg, books, [], lambda _: 1., **kwargs)\n+    assert expanded_actions == actions\n+    assert expanded_receipt['gross_cap'] == receipt['gross_cap']\n+    assert expanded_receipt['remaining_loss_budget'] == receipt['remaining_loss_budget']\n+\n+\n+def test_entry_endpoint_still_obeys_total_and_group_exposure():\n+    cfg = default_engine_config()\n+    cfg['max_symbol_weight'] = 1.0\n+    risk = RiskManager(cfg)\n+    assert risk.check_position_limits('300308', {}, 100000., 90000.)\n+    assert not risk.check_position_limits('300308', {}, 100000., 100001.)\n+    risk.symbol_groups = {'300308': 'sector'}\n+    risk.group_weight_limits = {'sector': .5}\n+    assert not risk.check_position_limits('300308', {}, 100000., 50001.)\n",
