+        proportional = [
+            min(book[3], math.ceil(book[3] * (1. - retain_scale) / 100.) * 100)
+            for book in ordered_books
+        ]
+        # Preserve the exact current reduction for every symbol/strategy group,
+        # but avoid fragmenting every economically equivalent funded-sleeve book.
+        # Concentrating an already-required reduction into the fewest live book
+        # identities keeps immediate strategy-level gross/stress unchanged while
+        # leaving untouched copies genuinely untouched for later native decisions.
+        group_relief: dict[tuple[str, str], int] = {}
+        group_books: dict[tuple[str, str], list[tuple[int, str, str, int, float]]] = {}
+        for book, reduction in zip(ordered_books, proportional, strict=True):
+            key = (book[1], book[2])
+            group_relief[key] = group_relief.get(key, 0) + reduction
+            group_books.setdefault(key, []).append(book)
+        sparse_reductions: dict[tuple[int, str, str], int] = {}
