--- a/quantfusion/engine/sector_risk.py
+++ b/quantfusion/engine/sector_risk.py
@@ -8,6 +8,7 @@ from __future__ import annotations
 import numpy as np
 import pandas as pd
 
+from quantfusion.config.universe import ESTABLISHED_BASE_CORE
 from quantfusion.domain.models import BarContext, SectorObservation, Signal
 from quantfusion.strategy.trend import BaseStrategy, EARLY_DUAL_TRANSITION_RSI_MAX
 
@@ -233,6 +234,18 @@ class CoreSectorRiskMixin:
             and sector_above_ma
         )
 
+    def _allows_horizon_discovery(
+        self, code: str, held_symbols: set[str]
+    ) -> bool:
+        """Keep long-horizon new discovery on the established core when present."""
+        if code in held_symbols:
+            return True
+        if getattr(self, "sleeve_name", None) not in {"base", "slow"}:
+            return True
+        tradable = set(getattr(self, "_tradable_symbol_codes", ()))
+        established = tradable.intersection(ESTABLISHED_BASE_CORE)
+        return not established or code in established
+
     def _collect_strategy_signals(
         self,
         symbols_dict: dict[str, str],
@@ -270,6 +283,8 @@ class CoreSectorRiskMixin:
                         pending, code, strategy.name
                     ):
                         continue
+                    if not self._allows_horizon_discovery(code, held_symbols):
+                        continue
                     rsi = ind_map[code].get("rsi")
                     signal_day_rsi = (
                         float(rsi.iloc[i])
