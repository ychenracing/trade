diff --git a/tests/unit/test_simultaneous_native_buy_funding.py b/tests/unit/test_simultaneous_native_buy_funding.py
new file mode 100644
index 0000000..9190ca0
--- /dev/null
+++ b/tests/unit/test_simultaneous_native_buy_funding.py
@@ -0,0 +1,219 @@
+"""Simultaneous funding must not turn symbol ranking into a cash-allocation rule."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+
+import pandas as pd
+
+from quantfusion.config.engine import default_engine_config
+from quantfusion.domain.models import Position, Signal
+from quantfusion.engine.universe import SleeveBacktestEngine
+from quantfusion.config.portfolio import PortfolioPolicy
+from quantfusion.strategy.trend import TurtleBreakoutStrategy
+
+
+def _frame(price: float = 10.0) -> pd.DataFrame:
+    dates = pd.bdate_range("2026-01-02", periods=25)
+    return pd.DataFrame(
+        {
+            "open": price,
+            "close": price,
+            "high": price,
+            "low": price,
+            "volume": 10_000_000.0,
+        },
+        index=dates,
+    )
+
+
+def _run_two_symbol_funding(
+    scores: Mapping[str, float], *, group_limit: float | None = None
+) -> tuple[dict[str, int], float]:
+    cfg = default_engine_config()
+    cfg["max_symbol_weight"] = 1.0
+    cfg["max_positions"] = 6
+    policy = PortfolioPolicy(allocation_mode="single")
+    sleeve = SleeveBacktestEngine(
+        1_000_000.0,
+        cfg=cfg,
+        policy=policy,
+        allocation_lookbacks=policy.single_lookbacks,
+        sleeve_name="test",
+    )
+    if group_limit is not None:
+        sleeve.risk.symbol_groups = {"300308": "optical", "300502": "optical"}
+        sleeve.risk.group_weight_limits = {"optical": group_limit}
+    data_map = {"300308": _frame(), "300502": _frame()}
+    date = next(iter(data_map.values())).index[-1]
+    date_to_pos = {d: i for i, d in enumerate(next(iter(data_map.values())).index)}
+    strategies = {
+        code: TurtleBreakoutStrategy(cfg)
+        for code in data_map
+    }
+    pending = [
+        (
+            Signal(
+                code,
+                strategies[code].name,
+                "buy",
+                target_shares=80_000,
+                signal_date=(date - pd.offsets.BDay(1)).strftime("%Y-%m-%d"),
+                price=10.0,
+                atr=0.0,
+            ),
+            strategies[code],
+        )
+        for code in data_map
+    ]
+    sleeve._allocation_scores = lambda *_args, **_kwargs: dict(scores)
+    sleeve._execute_pending_signals(pending, data_map, date, date_to_pos)
+    shares = {code: 0 for code in data_map}
+    for trade in sleeve.trades:
+        if trade.direction == "buy":
+            shares[trade.symbol] += trade.shares
+    return shares, sleeve.cash
+
+
+def test_multi_symbol_cash_funding_is_independent_of_symbol_ranking() -> None:
+    first, first_cash = _run_two_symbol_funding({"300308": 2.0, "300502": 1.0})
+    second, second_cash = _run_two_symbol_funding({"300308": 1.0, "300502": 2.0})
+
+    assert first == second
+    assert first_cash == second_cash
+    assert first["300308"] > 0
+    assert first["300502"] > 0
+
+
+def test_multi_symbol_group_capacity_is_order_invariant_and_never_exceeded() -> None:
+    first, _ = _run_two_symbol_funding(
+        {"300308": 2.0, "300502": 1.0}, group_limit=0.50
+    )
+    second, _ = _run_two_symbol_funding(
+        {"300308": 1.0, "300502": 2.0}, group_limit=0.50
+    )
+
+    assert first == second
+    # 10.01 execution price after 0.1% slippage. The native group ceiling is 500k.
+    assert sum(first.values()) * 10.01 <= 500_000.0 + 1e-9
+
+
+def test_one_symbol_path_keeps_native_behavior() -> None:
+    cfg = default_engine_config()
+    cfg["max_symbol_weight"] = 1.0
+    policy = PortfolioPolicy(allocation_mode="single")
+    sleeve = SleeveBacktestEngine(
+        1_000_000.0,
+        cfg=cfg,
+        policy=policy,
+        allocation_lookbacks=policy.single_lookbacks,
+        sleeve_name="test",
+    )
+    frame = _frame()
+    date = frame.index[-1]
+    date_to_pos = {d: i for i, d in enumerate(frame.index)}
+    strategy = TurtleBreakoutStrategy(cfg)
+    signal = Signal(
+        "300308",
+        strategy.name,
+        "buy",
+        target_shares=20_000,
+        signal_date=(date - pd.offsets.BDay(1)).strftime("%Y-%m-%d"),
+        price=10.0,
+        atr=0.0,
+    )
+    expected = sleeve._buy_batch_capacity([(signal, strategy)], {"300308": frame}, date)
+
+    sleeve._execute_pending_signals(
+        [(signal, strategy)], {"300308": frame}, date, date_to_pos
+    )
+
+    assert sum(t.shares for t in sleeve.trades if t.direction == "buy") == expected
+
+
+def _run_single_pending_in_universe(symbols: tuple[str, ...]) -> int:
+    cfg = default_engine_config()
+    cfg["max_positions"] = 6
+    policy = PortfolioPolicy(allocation_mode="single")
+    sleeve = SleeveBacktestEngine(
+        1_000_000.0,
+        cfg=cfg,
+        policy=policy,
+        allocation_lookbacks=policy.single_lookbacks,
+        sleeve_name="test",
+    )
+    dates = pd.bdate_range("2026-01-02", periods=25)
+    data_map = {
+        code: pd.DataFrame(
+            {
+                "open": 10.0,
+                "close": 10.0,
+                "high": 10.0,
+                "low": 10.0,
+                "volume": 100_000_000.0,
+            },
+            index=dates,
+        )
+        for code in symbols
+    }
+    date = dates[-1]
+    date_to_pos = {d: i for i, d in enumerate(dates)}
+    strategy = TurtleBreakoutStrategy(cfg)
+    signal = Signal(
+        symbols[0],
+        strategy.name,
+        "buy",
+        target_shares=80_000,
+        signal_date=(date - pd.offsets.BDay(1)).strftime("%Y-%m-%d"),
+        price=10.0,
+        atr=0.0,
+    )
+    sleeve._execute_pending_signals(
+        [(signal, strategy)], data_map, date, date_to_pos
+    )
+    return sum(t.shares for t in sleeve.trades if t.direction == "buy")
+
+
+def test_single_symbol_universe_can_use_unlevered_entry_endpoint() -> None:
+    assert _run_single_pending_in_universe(("300308",)) == 80_000
+
+
+def test_multi_symbol_universe_single_demand_keeps_diversified_entry_cap() -> None:
+    shares = _run_single_pending_in_universe(("300308", "300502"))
+    assert shares <= 60_000
+    assert shares > 0
+
