+    def _buy_batch_cost(
+        self, items: list[tuple[Signal, BaseStrategy]], capacity: int
+    ) -> float:
+        """Return exact cash cost for a same-symbol proportional board-lot batch."""
+        if capacity <= 0:
+            return 0.0
+        _, _, execution_price = self._validated_buy_batch_request(items)
+        commission_rate = float(self.cfg.get("commission_rate", 0.00025))
+        min_commission = float(self.cfg.get("min_commission", 0.0))
+        allocations = self._allocate_lots_pro_rata(items, capacity)
+        return float(
+            sum(
+                shares * execution_price
+                + max(shares * execution_price * commission_rate, min_commission)
+                for shares in allocations
+                if shares > 0
+            )
+        )
+
+    def _capacity_for_buy_budget(
+        self,
+        items: list[tuple[Signal, BaseStrategy]],
+        ceiling: int,
+        budget: float,
+    ) -> int:
+        """Largest board-lot capacity whose exact per-strategy fees fit budget."""
+        ceiling = _floor_to_lot(ceiling)
+        if ceiling <= 0 or budget <= 0:
+            return 0
+        for capacity in range(ceiling, -1, -A_SHARE_LOT_SIZE):
+            if self._buy_batch_cost(items, capacity) <= budget + 1e-9:
+                return capacity
+        return 0
+
+    def _scale_symbol_capacities_to_value_limit(
+        self,
+        buy_batches: dict[str, list[tuple[Signal, BaseStrategy]]],
+        capacities: dict[str, int],
+        symbols: list[str],
+        limit_value: float,
+    ) -> None:
+        """Proportionally fit simultaneous symbol demand beneath one value cap."""
+        symbols = [symbol for symbol in symbols if capacities.get(symbol, 0) > 0]
+        if not symbols or limit_value <= 0:
+            for symbol in symbols:
+                capacities[symbol] = 0
+            return
+        prices = {
+            symbol: self._validated_buy_batch_request(buy_batches[symbol])[2]
+            for symbol in symbols
+        }
+        demand_values = {
+            symbol: capacities[symbol] * prices[symbol] for symbol in symbols
+        }
+        total_demand = sum(demand_values.values())
+        if total_demand <= limit_value + 1e-9:
+            return
+        targets = {
+            symbol: limit_value * demand_values[symbol] / total_demand
+            for symbol in symbols
+        }
+        for symbol in symbols:
+            capacities[symbol] = min(
+                capacities[symbol],
+                _floor_to_lot(targets[symbol] / prices[symbol]),
+            )
+        used = sum(capacities[symbol] * prices[symbol] for symbol in symbols)
+        while True:
+            feasible = [
+                symbol
+                for symbol in symbols
+                if capacities[symbol] + A_SHARE_LOT_SIZE
+                <= _floor_to_lot(demand_values[symbol] / prices[symbol])
+                and used + A_SHARE_LOT_SIZE * prices[symbol] <= limit_value + 1e-9
+            ]
+            if not feasible:
