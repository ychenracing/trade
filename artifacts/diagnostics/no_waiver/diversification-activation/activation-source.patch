+            symbol = min(
+                feasible,
+                key=lambda code: (
+                    -(targets[code] - capacities[code] * prices[code]),
+                    code,
+                ),
+            )
+            capacities[symbol] += A_SHARE_LOT_SIZE
+            used += A_SHARE_LOT_SIZE * prices[symbol]
+
