+"""Account risk recovery must not be inferred from one unbinding close."""
+import pytest
+from quantfusion.config.engine import default_engine_config
+from quantfusion.domain.models import Signal
+from quantfusion.risk.account_budget import plan_account_risk_budget
+
+
+def plan(equity, gross, *, previous=None):
+    cfg = default_engine_config()
+    books = [(0, "300308", "turtle_breakout", int(gross / 10), 10.)]
+    buys = [(0, Signal("300308", "turtle_breakout", "buy", 1000, 10., signal_date="2026-01-06"), 10000.)]
+    extra = {} if previous is None else {"prior_envelope": previous}
+    return plan_account_risk_budget(equity, 100000., cfg, books, buys, lambda _: 1., date_str="2026-01-06", **extra)
+
+
+def test_first_binding_close_arms_recovery_without_clearing_peak():
+    receipt, actions = plan(91000., 85000.)
+    assert receipt.get("budget_defense_active") is True
+    assert receipt["buy_scale"] == 0.
+    assert receipt["lifetime_peak"] == 100000.
+    assert actions
+
+
+def test_unbinding_rebound_cannot_immediately_restore_buy_risk():
+    receipt, _ = plan(94000., 73000., previous={"date": "2026-01-05", "budget_defense_active": True})
+    assert receipt["buy_envelope_binding"] is False
+    assert receipt["buy_scale"] == 0.
+    assert receipt["budget_defense_active"] is True
+    assert receipt["lifetime_peak"] == 100000.
+
+
+def test_new_high_releases_episode_using_actual_equity_not_time():
+    receipt, _ = plan(100000., 73000., previous={"date": "2025-01-01", "budget_defense_active": True})
+    assert receipt["budget_defense_active"] is False
+    assert receipt["buy_scale"] == 1.
+
+
+def test_elapsed_time_does_not_erase_unrecovered_risk():
+    receipt, _ = plan(94000., 73000., previous={"date": "2025-01-01", "budget_defense_active": True})
+    assert receipt["buy_scale"] == 0.
+
+
+def test_future_budget_state_is_rejected():
+    with pytest.raises(ValueError, match="prior.*close"):
+        plan(94000., 73000., previous={"date": "2026-01-07", "budget_defense_active": True})
+
+
+def test_unvalidated_truthy_episode_flag_is_rejected():
+    with pytest.raises(ValueError, match="boolean"):
+        plan(94000., 73000., previous={"date": "2026-01-05", "budget_defense_active": "false"})
+
+
+def test_defense_trims_held_gap_excess_even_if_generic_gross_rebounds():
+    receipt, actions = plan(94000., 73000., previous={"date": "2026-01-05", "budget_defense_active": True})
+    assert receipt["buy_envelope_binding"] is False
+    released_gap = sum(a.shares * a.price * (.2 + receipt["cost_rate"]) for a in actions)
+    assert receipt["current_gap_debit"] - released_gap <= receipt["remaining_loss_budget"] + 1e-8
+    assert actions
+
+
+def test_causal_market_recovery_can_fund_an_unlocked_flat_account():
+    cfg = default_engine_config()
+    signal = Signal("300308", "turtle_breakout", "buy", 1000, 10., signal_date="2026-01-06")
+    receipt, actions = plan_account_risk_budget(94000., 100000., cfg, [], [(0, signal, 10000.)], lambda _: 1.,
+        date_str="2026-01-06", prior_envelope={"date": "2026-01-05", "budget_defense_active": True}, recovery_confirmed=True)
+    assert receipt["budget_defense_active"] is False
+    assert receipt["buy_scale"] == 1.
+    assert receipt["lifetime_peak"] == 100000.
+    assert not actions
+
+
+def test_market_recovery_cannot_override_a_binding_loss_budget():
+    cfg = default_engine_config()
+    receipt, _ = plan_account_risk_budget(85000., 100000., cfg, [(0, "300308", "turtle_breakout", 8000, 10.)], [], lambda _: 1.,
+        date_str="2026-01-06", prior_envelope={"date": "2026-01-05", "budget_defense_active": True}, recovery_confirmed=True)
+    assert receipt["budget_defense_active"] is True
+    assert receipt["buy_scale"] == 0.
+
+
+def test_reference_breakout_ignores_future_prices_and_refuses_missing_basket():
+    from types import SimpleNamespace
+    import pandas as pd
+    from quantfusion.config.portfolio import PortfolioPolicy
+    from quantfusion.risk.account_budget import market_budget_recovery
+    dates = pd.bdate_range("2026-01-01", periods=23)
+    frames = {s: pd.DataFrame({"close": [10.] * 20 + [12., 999., 999.]}, index=dates) for s in PortfolioPolicy().regime_symbols}
+    states = [SimpleNamespace(data_map=frames)]
+    assert market_budget_recovery(states, dates[19], default_engine_config()) is False
+    assert market_budget_recovery(states, dates[20], default_engine_config()) is True
+    for frame in frames.values():
+        frame.loc[dates[20], "close"] = 10.
+    assert market_budget_recovery(states, dates[20], default_engine_config()) is False
+    del frames[PortfolioPolicy().regime_symbols[0]]
+    assert market_budget_recovery(states, dates[20], default_engine_config()) is False
